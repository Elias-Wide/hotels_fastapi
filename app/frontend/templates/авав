<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Бронирование</title>
</head>
<body>
  <div>
    {% for hotel in hotels %}
      <div style="display:flex; margin-bottom:50px; margin-left:400px;">
        <img src="{{ url_for('static', path='images/' + hotel.image_id|string + '.webp') }}"
        alt="Изображение отеля"
        width="200">
        <h1>{{ hotel.name }}</h1>    
      </div>
    {% endfor %}
  </div>
</body>
</html>